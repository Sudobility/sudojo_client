{
  "name": "@sudobility/sudojo_client",
  "version": "0.0.170",
  "description": "TypeScript client library for Sudojo API",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run build",
    "test:unit": "vitest run",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "check-all": "bun run lint && bun run typecheck && bun run test:unit",
    "verify": "bun run lint && bun run typecheck && bun run test:unit && bun run build"
  },
  "keywords": [
    "sudojo",
    "sudoku",
    "client",
    "typescript",
    "api"
  ],
  "author": "Sudobility Team",
  "license": "BUSL-1.1",
  "peerDependencies": {
    "@sudobility/di": "^1.5.76",
    "@sudobility/sudojo_types": "^1.2.77",
    "@sudobility/types": "^1.9.75",
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "@sudobility/di": "^1.5.76",
    "@sudobility/sudojo_types": "^1.2.77",
    "@sudobility/types": "^1.9.75",
    "@tanstack/react-query": "~5.104.5",
    "@testing-library/react": "~16.3.3",
    "@types/node": "~24.19.2",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "@vitest/coverage-v8": "~3.2.7",
    "eslint": "~9.39.5",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.7",
    "happy-dom": "~20.14.6",
    "prettier": "~3.9.10",
    "typescript": "~5.9.3",
    "vitest": "~3.2.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/sudojo_client.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./network": {
      "types": "./dist/network/index.d.ts",
      "import": "./dist/network/index.js",
      "default": "./dist/network/index.js"
    },
    "./package.json": "./package.json"
  }
}
